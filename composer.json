            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "tordetect",
        "tor api",
        "tor node checker",
        "tor detection api",
        "tor exit node checker",
        "tor ip checker"
    ],
    "homepage": "https://apiverve.com/marketplace/tordetect?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/tordetect",
        "source": "https://github.com/apiverve/tordetect-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Tordetect\\": "php/src/"
        }
    },
    "autoload-dev": {
